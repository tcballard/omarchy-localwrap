RENAME_NOREPLACE = 1
RENAME_EXCHANGE = 2
F_ADD_SEALS = getattr(fcntl, "F_ADD_SEALS", 1033)
F_SEAL_SEAL = getattr(fcntl, "F_SEAL_SEAL", 0x0001)
F_SEAL_SHRINK = getattr(fcntl, "F_SEAL_SHRINK", 0x0002)
F_SEAL_GROW = getattr(fcntl, "F_SEAL_GROW", 0x0004)
F_SEAL_WRITE = getattr(fcntl, "F_SEAL_WRITE", 0x0008)


class LocalWrapError(Exception):
    pass


def emit(value: Any) -> None:
    data = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if len(data.encode("utf-8")) > MAX_RESPONSE_BYTES:
        raise LocalWrapError("bounded helper response exceeded its output limit")
    sys.stdout.write(data + "\n")


def diagnostic(code: str, scope: str, message: str) -> dict[str, str]:
    return {"code": code, "scope": scope, "message": message}


def read_bounded_fd(descriptor: int, limit: int, label: str) -> bytes:
    try:
        os.lseek(descriptor, 0, os.SEEK_SET)
        chunks: list[bytes] = []
        total = 0
        while total <= limit:
            chunk = os.read(descriptor, min(65536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        data = b"".join(chunks)
    except OSError as exc:
        raise LocalWrapError(f"cannot read {label}: {exc.strerror or exc}") from exc
    if len(data) > limit:
        raise LocalWrapError(f"{label} exceeds the {limit}-byte limit")
    if b"\x00" in data:
        raise LocalWrapError(f"{label} contains a NUL byte")
    return data


def read_bounded(path: Path, limit: int, label: str) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise LocalWrapError(f"cannot read {label}: {exc.strerror or exc}") from exc
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise LocalWrapError(f"{label} is not a regular file")
        return read_bounded_fd(descriptor, limit, label)
    finally:
        os.close(descriptor)


def bytes_digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def json_depth(raw: bytes) -> int:
    depth = maximum = 0
    in_string = escape = False
    for byte in raw:
        char = chr(byte)
        if in_string:
            if escape:
                escape = False
            elif char == "\\":
                escape = True
            elif char == '"':
                in_string = False
            continue
        if char == '"':
            in_string = True
        elif char in "[{":
            depth += 1
            maximum = max(maximum, depth)
            if maximum > MAX_JSON_DEPTH:
                return maximum
        elif char in "]}":
            depth -= 1
            if depth < 0:
                return MAX_JSON_DEPTH + 1
    return maximum


def decode_json(raw: bytes, label: str) -> Any:
    if json_depth(raw) > MAX_JSON_DEPTH:
        raise LocalWrapError(f"{label} exceeds the JSON depth limit of {MAX_JSON_DEPTH}")
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise LocalWrapError(f"{label} is not valid UTF-8 JSON: {exc}") from exc


def load_json(path: Path, limit: int, label: str) -> Any:
    return decode_json(read_bounded(path, limit, label), label)


def fd_identity(descriptor: int) -> dict[str, int]:
    details = os.fstat(descriptor)
    return {"device": details.st_dev, "inode": details.st_ino}


def fd_display_path(descriptor: int) -> str:
    return os.readlink(f"/proc/self/fd/{descriptor}").removesuffix(" (deleted)")


def relative_parts(relative: str, scope: str) -> list[str]:
    value = ensure_string(relative, scope, MAX_PATH)
    path = Path(value)
    if path.is_absolute():
        raise LocalWrapError(f"{scope} must be relative to the repository")
    parts = [part for part in path.parts if part != "."]
    if any(part in {"", ".."} for part in parts):
        raise LocalWrapError(f"{scope} must not traverse outside its base directory")
    return parts


def open_relative_fd(base_descriptor: int, relative: str, scope: str, *, directory: bool) -> int:
    parts = relative_parts(relative, scope)
    current = os.dup(base_descriptor)
    try:
        for index, part in enumerate(parts):
            final = index == len(parts) - 1
            flags = os.O_CLOEXEC | os.O_NOFOLLOW
            flags |= os.O_RDONLY
            if not final or directory:
                flags |= os.O_DIRECTORY
            next_descriptor = os.open(part, flags, dir_fd=current)
            details = os.fstat(next_descriptor)
            expected = stat.S_ISDIR(details.st_mode) if (not final or directory) else stat.S_ISREG(details.st_mode)
            if not expected:
                os.close(next_descriptor)
                kind = "directory" if (not final or directory) else "regular file"
                raise LocalWrapError(f"{scope} must resolve to a {kind}")
            os.close(current)
            current = next_descriptor
        if not parts and not directory:
            raise LocalWrapError(f"{scope} must name a regular file")
        return current
    except OSError as exc:
        os.close(current)
        raise LocalWrapError(f"{scope} cannot be opened without following links: {exc.strerror or exc}") from exc
    except BaseException:
        os.close(current)
        raise


def sealed_snapshot(raw: bytes, label: str) -> int:
    try:
        descriptor = os.memfd_create(f"localwrap-{label}", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.lseek(descriptor, 0, os.SEEK_SET)
        fcntl.fcntl(
            descriptor,
            F_ADD_SEALS,
            F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL,
        )
        return descriptor
    except (AttributeError, OSError) as exc:
        try:
            os.close(descriptor)
        except (NameError, OSError):
            pass
        raise LocalWrapError(f"cannot create immutable {label} snapshot: {exc}") from exc


def ensure_string(value: Any, scope: str, maximum: int, *, nonempty: bool = True) -> str:
    if not isinstance(value, str):
        raise LocalWrapError(f"{scope} must be a string")
    if len(value) > maximum:
        raise LocalWrapError(f"{scope} exceeds the {maximum}-character limit")
    result = value.strip()
    if nonempty and not result:
        raise LocalWrapError(f"{scope} must not be empty")
    if any(ord(char) < 32 and char not in "\t" for char in result):
        raise LocalWrapError(f"{scope} contains control characters")
    return result


def ensure_object(value: Any, scope: str, fields: set[str]) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise LocalWrapError(f"{scope} must be an object")
    unknown = sorted(set(value) - fields)
    if unknown:
        raise LocalWrapError(f'{scope} contains unknown field "{unknown[0]}"')
    return value


def is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def real_directory(path: Path, scope: str) -> Path:
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise LocalWrapError(f"{scope} cannot be resolved: {exc.strerror or exc}") from exc
    if not resolved.is_dir():
        raise LocalWrapError(f"{scope} is not a directory")
    return resolved


def resolve_repository(value: str) -> Path:
    path_text = ensure_string(value, "repository path", 4096)
    path = Path(os.path.expanduser(path_text))
    if not path.is_absolute():
        raise LocalWrapError("repository path must be absolute or start with ~/")
    return real_directory(path, "repository")


def configured_path(value: str, scope: str = "repository path") -> str:
    path_text = ensure_string(value, scope, 4096)
    path = Path(os.path.expanduser(path_text))
    if not path.is_absolute():
        raise LocalWrapError(f"{scope} must be absolute or start with ~/")
    return os.path.normpath(str(path))


def contained_path(root: Path, relative: str, scope: str, *, file_required: bool = False) -> Path:
    value = ensure_string(relative, scope, MAX_PATH)
    path = Path(value)
    if path.is_absolute():
        raise LocalWrapError(f"{scope} must be relative to the repository")
    try:
        resolved = (root / path).resolve(strict=True)
    except OSError as exc:
        raise LocalWrapError(f"{scope} cannot be resolved: {exc.strerror or exc}") from exc
    if not is_within(resolved, root):
        raise LocalWrapError(f"{scope} resolves outside the repository")
    if file_required and not resolved.is_file():
        raise LocalWrapError(f"{scope} must resolve to a regular file")
    if not file_required and not resolved.is_dir():
        raise LocalWrapError(f"{scope} must resolve to a directory")
    return resolved


def slug(value: str) -> str:
    output = []
    dash = False
    for char in value.lower():
        if "a" <= char <= "z" or "0" <= char <= "9":
            output.append(char)
            dash = False
        elif output and not dash:
            output.append("-")
            dash = True
    result = "".join(output).strip("-")
    return result or "item"


def unique_slug(value: str, used: set[str]) -> str:
    base = slug(value)
    candidate = base
    suffix = 2
    while candidate in used:
        candidate = f"{base}-{suffix}"
        suffix += 1
    used.add(candidate)
    return candidate


def numeric_loopback_url(value: Any, scope: str, default_port: int | None = None) -> str:
    if value is None:
        if default_port is None:
            raise LocalWrapError(f"{scope} is required")
        return f"http://127.0.0.1:{default_port}"
    text = ensure_string(value, scope, MAX_URL)
    try:
        parsed = urlsplit(text)
        port = parsed.port
    except ValueError as exc:
        raise LocalWrapError(f"{scope} is invalid: {exc}") from exc
    if parsed.scheme not in {"http", "https"}:
        raise LocalWrapError(f"{scope} scheme must be http or https")
    if parsed.username is not None or parsed.password is not None:
        raise LocalWrapError(f"{scope} must not contain user information")
    if parsed.hostname not in LOOPBACK_HOSTS:
        raise LocalWrapError(f"{scope} host must be numeric loopback 127.0.0.1 or [::1]")
    if port is None or not 1000 <= port <= 65535:
        raise LocalWrapError(f"{scope} requires an explicit port from 1000 to 65535")
    host = "[::1]" if parsed.hostname == "::1" else "127.0.0.1"
    return urlunsplit((parsed.scheme, f"{host}:{port}", parsed.path, parsed.query, parsed.fragment))


def manifest_file(root: Path) -> Path:
    for relative in MANIFESTS:
        candidate = root / relative
        if candidate.is_symlink():
            raise LocalWrapError(f"manifest {relative} must not be a symlink")
        if candidate.is_file():
            resolved = candidate.resolve(strict=True)
            if not is_within(resolved, root):
                raise LocalWrapError(f"manifest {relative} resolves outside the repository")
            return resolved
    raise LocalWrapError("no .localwrap/workspace.json or localwrap.json found")


def parse_command(command: Any) -> list[str]:
    text = ensure_string(command, "project command", MAX_COMMAND)
    if any(char in FORBIDDEN_COMMAND_CHARS for char in text):
        raise LocalWrapError("project command contains shell syntax or quoting")
    argv = text.split()
    if not argv or argv[0] not in ALLOWED_EXECUTABLES:
        raise LocalWrapError("project command executable is not allowed")
    if len(argv) > MAX_ARGUMENTS + 1 or any(len(arg) > MAX_ARGUMENT for arg in argv):
        raise LocalWrapError("project command exceeds argument limits")
    exe = argv[0]
    if exe in {"npm", "pnpm", "yarn", "bun"}:
        valid = len(argv) == 3 and argv[1] == "run" and not argv[2].startswith("-")
        valid = valid or (exe == "npm" and len(argv) == 2 and argv[1] == "start")
        if not valid:
            raise LocalWrapError(
                "package managers permit only an exact local script: <manager> run <name> or npm start"
            )
    elif exe in {"node", "python", "python3"}:
        if len(argv) < 2 or argv[1].startswith("-"):
            raise LocalWrapError("interpreters require a repository-contained script path")
    return argv


def parse_manifest_document(
    root: Path,
    path: Path,
    document: Any,
    directory_resolver: Any = contained_path,
) -> dict[str, Any]:
    manifest = ensure_object(document, "manifest", ROOT_FIELDS)
    if manifest.get("localwrap") != 1:
        raise LocalWrapError('manifest requires "localwrap": 1')
    name = ensure_string(manifest.get("name", root.name), "workspace name", MAX_NAME)
    raw_projects = manifest.get("projects")
    if not isinstance(raw_projects, list) or not raw_projects:
        raise LocalWrapError("manifest requires at least one project")
    if len(raw_projects) > MAX_PROJECTS:
        raise LocalWrapError(f"manifest exceeds the {MAX_PROJECTS}-project limit")

    used: set[str] = set()
    projects: list[dict[str, Any]] = []
    raw_dependencies: list[list[str]] = []
    for index, item in enumerate(raw_projects):
        scope = f"projects[{index}]"
        raw = ensure_object(item, scope, PROJECT_FIELDS)
        explicit_id = ensure_string(raw["id"], f"{scope}.id", MAX_ID) if "id" in raw else ""
        project_name = ensure_string(raw.get("name", explicit_id or f"Project {index + 1}"), f"{scope}.name", MAX_NAME)
        project_id = unique_slug(explicit_id or project_name or f"project-{index + 1}", used)
        relative = ensure_string(raw.get("path", "."), f"{scope}.path", MAX_PATH)
        cwd = directory_resolver(root, relative, f"{scope}.path")
        argv = parse_command(raw.get("command"))
        port = raw.get("port", 3000)
        if isinstance(port, bool) or not isinstance(port, int) or not 1000 <= port <= 65535:
            raise LocalWrapError(f"{scope}.port must be an integer from 1000 to 65535")
        url = numeric_loopback_url(raw.get("url"), f"{scope}.url", port)
        health = raw.get("healthCheck")
        if health is None:
            health_url = url
        else:
            health_obj = ensure_object(health, f"{scope}.healthCheck", HEALTH_FIELDS)
            has_path = "path" in health_obj
            has_url = "url" in health_obj
            if has_path == has_url:
                raise LocalWrapError(f"{scope}.healthCheck requires exactly one of path or url")
            if has_url:
                health_url = numeric_loopback_url(health_obj["url"], f"{scope}.healthCheck.url")
            else:
                health_path = ensure_string(health_obj["path"], f"{scope}.healthCheck.path", MAX_PATH)
                if not health_path.startswith("/") or health_path.startswith("//"):
                    raise LocalWrapError(f"{scope}.healthCheck.path must start with one /")
                parsed = urlsplit(url)
                health_url = urlunsplit((parsed.scheme, parsed.netloc, health_path, "", ""))
        dependencies = raw.get("dependsOn", [])
        if not isinstance(dependencies, list) or len(dependencies) > MAX_DEPENDENCIES:
            raise LocalWrapError(f"{scope}.dependsOn exceeds the {MAX_DEPENDENCIES}-dependency limit")
        deps = [ensure_string(dep, f"{scope}.dependsOn", MAX_ID) for dep in dependencies]
        for boolean_field, default in (("autostart", False), ("openOnReady", True)):
            if boolean_field in raw and not isinstance(raw[boolean_field], bool):
                raise LocalWrapError(f"{scope}.{boolean_field} must be boolean")
        projects.append({
            "id": project_id, "name": project_name, "path": relative,
            "commandLine": " ".join(argv), "port": port, "url": url,
            "healthCheckURL": health_url, "autostart": bool(raw.get("autostart", False)),
            "openOnReady": bool(raw.get("openOnReady", True)), "dependsOn": [],
            "cwd": str(cwd),
        })
        raw_dependencies.append(deps)

    by_id = {project["id"]: project for project in projects}
    for index, deps in enumerate(raw_dependencies):
        for dep in deps:
            dep_id = slug(dep)
            if dep_id not in by_id:
                raise LocalWrapError(f'projects[{index}].dependsOn references unknown project "{dep}"')
            if dep_id == projects[index]["id"]:
                raise LocalWrapError(f"projects[{index}] cannot depend on itself")
            if dep_id in projects[index]["dependsOn"]:
                raise LocalWrapError(f"projects[{index}].dependsOn contains a duplicate")
            projects[index]["dependsOn"].append(dep_id)

    visiting: set[str] = set()
    visited: set[str] = set()
    def visit(project_id: str) -> None:
        if project_id in visiting:
            raise LocalWrapError(f'dependency cycle involves "{project_id}"')
        if project_id in visited:
            return
        visiting.add(project_id)
        for dep in by_id[project_id]["dependsOn"]:
            visit(dep)
        visiting.remove(project_id)
        visited.add(project_id)
    for project in projects:
        visit(project["id"])

    raw_workspaces = manifest.get("workspaces", [])
    if not isinstance(raw_workspaces, list) or len(raw_workspaces) > MAX_WORKSPACES:
        raise LocalWrapError(f"workspaces must be an array of at most {MAX_WORKSPACES}")
    workspace_used: set[str] = set()
    workspaces: list[dict[str, Any]] = []
    for index, item in enumerate(raw_workspaces):
        scope = f"workspaces[{index}]"
        raw = ensure_object(item, scope, WORKSPACE_FIELDS)
        explicit_id = ensure_string(raw["id"], f"{scope}.id", MAX_ID) if "id" in raw else ""
        workspace_name = ensure_string(raw.get("name", explicit_id or f"Workspace {index + 1}"), f"{scope}.name", MAX_NAME)
        members = raw.get("projects")
        if not isinstance(members, list) or not members or len(members) > MAX_WORKSPACE_MEMBERS:
            raise LocalWrapError(f"{scope}.projects requires 1-{MAX_WORKSPACE_MEMBERS} members")
        member_ids: list[str] = []
        for member in members:
            member_id = slug(ensure_string(member, f"{scope}.projects", MAX_ID))
            if member_id not in by_id:
                raise LocalWrapError(f'{scope}.projects references unknown project "{member}"')
            if member_id in member_ids:
                raise LocalWrapError(f"{scope}.projects contains a duplicate")
            member_ids.append(member_id)
        workspaces.append({
            "id": unique_slug(explicit_id or workspace_name, workspace_used),
            "name": workspace_name, "projects": member_ids,
        })
    return {"name": name, "projects": projects, "workspaces": workspaces}


def parse_manifest(root: Path) -> tuple[Path, dict[str, Any]]:
    path = manifest_file(root)
    raw = read_bounded(path, MAX_MANIFEST_BYTES, "workspace manifest")
    document = decode_json(raw, "workspace manifest")
    return path, parse_manifest_document(root, path, document)


def manifest_snapshot(
    root: Path,
    root_descriptor: int,
    directory_resolver: Any = contained_path,
) -> tuple[Path, bytes, dict[str, Any]]:
    last_error: LocalWrapError | None = None
    for relative in MANIFESTS:
        try:
            descriptor = open_relative_fd(
                root_descriptor, relative, f"manifest {relative}", directory=False
            )
        except LocalWrapError as exc:
            last_error = exc
            continue
        try:
            raw = read_bounded_fd(descriptor, MAX_MANIFEST_BYTES, "workspace manifest")
        finally:
            os.close(descriptor)
        path = root / relative
        document = decode_json(raw, "workspace manifest")
        return path, raw, parse_manifest_document(root, path, document, directory_resolver)
    if last_error is not None and "No such file" not in str(last_error):
        raise last_error
    raise LocalWrapError("no .localwrap/workspace.json or localwrap.json found")


def load_config(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"repositories": [], "notifications": False, "openOnReady": False}
    document = load_json(path, MAX_CONFIG_BYTES, "repository configuration")
    root = ensure_object(document, "configuration", CONFIG_FIELDS)
    repositories = root.get("repositories", [])
    if not isinstance(repositories, list) or len(repositories) > MAX_REPOSITORIES:
        raise LocalWrapError(f"configuration permits at most {MAX_REPOSITORIES} repositories")
    resolved: list[str] = []
    for index, entry in enumerate(repositories):
        repository = configured_path(entry, f"repositories[{index}]")
        if repository in resolved:
            raise LocalWrapError("configuration contains a duplicate repository")
        resolved.append(repository)
    for field in ("notifications", "openOnReady"):
        if field in root and not isinstance(root[field], bool):
            raise LocalWrapError(f"configuration field {field} must be boolean")
    return {
        "repositories": resolved,
        "notifications": bool(root.get("notifications", False)),
        "openOnReady": bool(root.get("openOnReady", False)),
    }


def atomic_write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    payload = (json.dumps(value, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
    if len(payload) > MAX_CONFIG_BYTES:
        raise LocalWrapError("repository configuration exceeds its byte limit")
    descriptor, temporary = tempfile.mkstemp(prefix=".repositories.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def renameat2(
    old_directory: int, old_name: str, new_directory: int, new_name: str, flags: int
) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    function = getattr(libc, "renameat2", None)
    if function is None:
        raise LocalWrapError("this system does not provide race-safe renameat2 installation")
    function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    function.restype = ctypes.c_int
    result = function(
        old_directory, os.fsencode(old_name), new_directory, os.fsencode(new_name), flags
    )
    if result != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def entry_identity(directory: int, name: str) -> dict[str, int] | None:
    try:
        details = os.stat(name, dir_fd=directory, follow_symlinks=False)
    except FileNotFoundError:
        return None
    return {"device": details.st_dev, "inode": details.st_ino}


def open_owned_install_parent(target_parent: Path) -> int:
    home_text = os.environ.get("HOME")
    if not home_text:
        raise LocalWrapError("HOME is required for installation")
    home = Path(home_text)
    if not home.is_absolute():
        raise LocalWrapError("HOME must be absolute")
    expected = home / ".config" / "omarchy" / "plugins"
    if target_parent != expected:
        raise LocalWrapError(f"installation parent must be exactly {expected}")
    descriptor = os.open("/", os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY)
    try:
        for part in home.parts[1:]:
            next_descriptor = os.open(
                part,
                os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = next_descriptor
        if os.fstat(descriptor).st_uid != os.getuid():
            raise LocalWrapError("HOME must be owned by the installing user")
        for part in (".config", "omarchy", "plugins"):
            next_descriptor = os.open(
                part,
                os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
                dir_fd=descriptor,
            )
            if os.fstat(next_descriptor).st_uid != os.getuid():
                os.close(next_descriptor)
                raise LocalWrapError(f"installation ancestor {part} is not owned by the installing user")
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except OSError as exc:
        os.close(descriptor)
        raise LocalWrapError(f"installation ancestors must be real directories: {exc.strerror or exc}") from exc
    except BaseException:
        os.close(descriptor)
        raise


def verify_owned_plugin(directory_descriptor: int) -> None:
    if os.fstat(directory_descriptor).st_uid != os.getuid():
        raise LocalWrapError("installed plugin directory is not owned by the installing user")
    manifest_descriptor = open_relative_fd(
        directory_descriptor, "manifest.json", "installed manifest", directory=False
    )
    try:
        raw = read_bounded_fd(manifest_descriptor, MAX_MANIFEST_BYTES, "installed manifest")
    finally:
        os.close(manifest_descriptor)
    document = decode_json(raw, "installed manifest")
    if not isinstance(document, dict) or document.get("id") != "io.github.tcballard.localwrap":
        raise LocalWrapError("refusing to replace a directory not owned by LocalWrap")


def remove_tree_contents(directory_descriptor: int) -> None:
    with os.scandir(directory_descriptor) as entries:
        for entry in entries:
            details = entry.stat(follow_symlinks=False)
            if stat.S_ISDIR(details.st_mode):
                child = os.open(
                    entry.name,
                    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
                    dir_fd=directory_descriptor,
                )
                try:
                    if fd_identity(child) != {"device": details.st_dev, "inode": details.st_ino}:
                        raise LocalWrapError("retired installation changed during cleanup")
                    remove_tree_contents(child)
                finally:
                    os.close(child)
                os.rmdir(entry.name, dir_fd=directory_descriptor)
            else:
                os.unlink(entry.name, dir_fd=directory_descriptor)


def command_install_swap(staging: str, target: str, force: str) -> None:
    staging_path = Path(staging)
    target_path = Path(target)
    if not staging_path.is_absolute() or not target_path.is_absolute():
        raise LocalWrapError("installer paths must be absolute")
    if staging_path.parent != target_path.parent:
        raise LocalWrapError("staging and target must share one verified parent")
    if force not in {"0", "1"}:
        raise LocalWrapError("installer force flag must be 0 or 1")
    parent_descriptor = open_owned_install_parent(target_path.parent)
    lock_descriptor = -1
    staging_descriptor = -1
    target_descriptor = -1
    try:
        lock_descriptor = os.open(
            ".io.github.tcballard.localwrap.install.lock",
            os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
            dir_fd=parent_descriptor,
        )
        lock_details = os.fstat(lock_descriptor)
        if not stat.S_ISREG(lock_details.st_mode) or lock_details.st_uid != os.getuid():
            raise LocalWrapError("installer lock is not a user-owned regular file")
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
        staging_descriptor = os.open(
            staging_path.name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
            dir_fd=parent_descriptor,
        )
        if os.fstat(staging_descriptor).st_uid != os.getuid():
            raise LocalWrapError("staging directory is not owned by the installing user")
        staging_identity = fd_identity(staging_descriptor)
        target_identity = entry_identity(parent_descriptor, target_path.name)
        if target_identity is None:
            try:
                renameat2(
                    parent_descriptor, staging_path.name,
                    parent_descriptor, target_path.name,
                    RENAME_NOREPLACE,
                )
            except FileExistsError as exc:
                raise LocalWrapError("destination appeared during install; no files were displaced") from exc
            if entry_identity(parent_descriptor, target_path.name) != staging_identity:
                raise LocalWrapError("installed target identity changed during no-replace swap")
        else:
            if force != "1":
                raise LocalWrapError(f"already installed at {target_path}; re-run with --force")
            target_descriptor = os.open(
                target_path.name,
                os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY,
                dir_fd=parent_descriptor,
            )
            verify_owned_plugin(target_descriptor)
            held_target_identity = fd_identity(target_descriptor)
            if held_target_identity != target_identity:
                raise LocalWrapError("installed target changed before the locked swap")
            renameat2(
                parent_descriptor, staging_path.name,
                parent_descriptor, target_path.name,
                RENAME_EXCHANGE,
            )
            target_after = entry_identity(parent_descriptor, target_path.name)
            displaced_after = entry_identity(parent_descriptor, staging_path.name)
            if target_after != staging_identity or displaced_after != held_target_identity:
                # Exchange is its own exact inverse. Only attempt rollback while
                # both names still identify the objects from our transaction.
                if displaced_after == held_target_identity:
                    renameat2(
                        parent_descriptor, staging_path.name,
                        parent_descriptor, target_path.name,
                        RENAME_EXCHANGE,
                    )
                restored = entry_identity(parent_descriptor, target_path.name)
                if restored != held_target_identity:
                    raise LocalWrapError("swap was displaced and the prior installation could not be restored")
                raise LocalWrapError("swap verification failed; the prior installation was restored")
        os.fsync(parent_descriptor)
        backup: str | None = None
        if target_identity is not None:
            try:
                remove_tree_contents(target_descriptor)
                if entry_identity(parent_descriptor, staging_path.name) != held_target_identity:
                    raise LocalWrapError("retired installation name changed before removal")
                os.rmdir(staging_path.name, dir_fd=parent_descriptor)
                os.fsync(parent_descriptor)
            except (OSError, LocalWrapError):
                # The new exact target is already verified. Never chase or
                # delete a displaced name; retain it for manual inspection.
                backup = str(staging_path)
        emit({"ok": True, "target": str(target_path), "backup": backup})
    except OSError as exc:
        raise LocalWrapError(f"race-safe install swap failed: {exc.strerror or exc}") from exc
    finally:
        for descriptor in (target_descriptor, staging_descriptor, lock_descriptor, parent_descriptor):
            if descriptor >= 0:
                try:
                    os.close(descriptor)
                except OSError:
                    pass


def package_script_snapshot(
    cwd: Path, cwd_descriptor: int, argv: list[str]
) -> tuple[Path, bytes, str, list[dict[str, str]]]:
    descriptor = open_relative_fd(cwd_descriptor, "package.json", "package.json", directory=False)
    try:
        raw = read_bounded_fd(descriptor, MAX_PACKAGE_BYTES, "package.json")
    finally:
        os.close(descriptor)
    document = decode_json(raw, "package.json")
    if not isinstance(document, dict) or not isinstance(document.get("scripts"), dict):
        raise LocalWrapError("package.json has no scripts object")
    script_name = "start" if argv[0] == "npm" and argv[1] == "start" else argv[2]
    reviewed = []
    for name in ("pre" + script_name, script_name, "post" + script_name):
        if name in document["scripts"]:
            reviewed.append({
                "name": name,
                "value": ensure_string(document["scripts"].get(name), f'package script "{name}"', MAX_COMMAND),
            })
    if not any(item["name"] == script_name for item in reviewed):
        raise LocalWrapError(f'package script "{script_name}" is missing')
    return cwd / "package.json", raw, script_name, reviewed


def open_executable(command: str) -> tuple[Path, int]:
    executable = shutil.which(command)
    if executable is None:
        raise LocalWrapError(f'executable "{command}" was not found on PATH')
    try:
        path = Path(executable).resolve(strict=True)
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise LocalWrapError(f'executable "{command}" cannot be pinned: {exc.strerror or exc}') from exc
    if not stat.S_ISREG(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise LocalWrapError("resolved executable is not a regular file")
    return path, descriptor


def close_prepared(prepared: dict[str, Any]) -> None:
    for descriptor in prepared.get("descriptors", []):
        try:
            os.close(descriptor)
        except OSError:
            pass
    prepared["descriptors"] = []


def prepare_launch(root: Path, project_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    root_descriptor = os.open(root, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY)
    prepared: dict[str, Any] = {"descriptors": [root_descriptor]}
    try:
        def validate_directory(_root: Path, relative: str, scope: str) -> Path:
            descriptor = open_relative_fd(root_descriptor, relative, scope, directory=True)
            try:
                return Path(fd_display_path(descriptor))
            finally:
                os.close(descriptor)

        manifest_path, manifest_raw, manifest = manifest_snapshot(
            root, root_descriptor, validate_directory
        )
        project = next((item for item in manifest["projects"] if item["id"] == project_id), None)
        if project is None:
            raise LocalWrapError(f'project "{project_id}" is not in the current manifest')
        argv = parse_command(project["commandLine"])
        cwd_descriptor = open_relative_fd(
            root_descriptor, project["path"], "project directory", directory=True
        )
        prepared["descriptors"].append(cwd_descriptor)
        cwd = Path(fd_display_path(cwd_descriptor))
        origins = [{
            "kind": "manifest", "path": str(manifest_path),
            "sha256": bytes_digest(manifest_raw),
        }]
        review_detail = ""
        package_launchers = {"npm", "pnpm", "yarn", "bun"}
        if argv[0] in package_launchers:
            requested_path, requested_descriptor = open_executable(argv[0])
            os.close(requested_descriptor)
            shell_path, executable_descriptor = open_executable("sh")
            prepared["descriptors"].append(executable_descriptor)
            package_path, package_raw, script_name, scripts = package_script_snapshot(
                cwd, cwd_descriptor, argv
            )
            origins.append({
                "kind": "package-script", "path": str(package_path), "name": script_name,
                "scripts": scripts, "sha256": bytes_digest(package_raw),
            })
            review_detail = (
                f"Held package snapshot: {package_path} (sha256 {origins[-1]['sha256']})"
                f"\nRequested launcher: {requested_path}"
                f"\nExecution: {shell_path} -c each exact reviewed lifecycle string"
            )
            for item in scripts:
                review_detail += f"\n{item['name']}: {item['value']}"
            prepared.update({"kind": "package", "steps": scripts})
            execution_argv = [[str(shell_path), "-c", item["value"]] for item in scripts]
            executable_path = shell_path
        else:
            executable_path, executable_descriptor = open_executable(argv[0])
            prepared["descriptors"].append(executable_descriptor)
            script_descriptor = open_relative_fd(
                cwd_descriptor, argv[1], "interpreter script", directory=False
            )
            try:
                script_raw = read_bounded_fd(script_descriptor, MAX_SCRIPT_BYTES, "interpreter script")
                script_identity = fd_identity(script_descriptor)
            finally:
                os.close(script_descriptor)
            immutable_script = sealed_snapshot(script_raw, "script")
            prepared["descriptors"].append(immutable_script)
            script_path = cwd / argv[1]
            origins.append({
                "kind": "script", "path": str(script_path),
                "sha256": bytes_digest(script_raw), "identity": script_identity,
            })
            review_detail = (
                f"Immutable local script snapshot: {script_path}"
                f"\nsha256: {origins[-1]['sha256']}"
            )
            prepared.update({
                "kind": "interpreter", "interpreter": argv[0],
                "scriptDescriptor": immutable_script, "scriptPath": str(script_path),
                "tail": argv[2:],
            })
            execution_argv = [[str(executable_path), "<sealed-script-snapshot>", *argv[2:]]]

        executable_descriptor = prepared["descriptors"][-2 if prepared["kind"] == "interpreter" else -1]
        core = {
            "repository": str(root), "projectId": project["id"], "projectName": project["name"],
            "cwd": str(cwd), "cwdIdentity": fd_identity(cwd_descriptor),
            "executable": str(executable_path),
            "executableIdentity": fd_identity(executable_descriptor),
            "argv": execution_argv, "displayCommand": project["commandLine"],
            "port": project["port"], "origins": origins, "reviewDetail": review_detail,
        }
        fingerprint = hashlib.sha256(
            json.dumps(core, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        prepared["executableDescriptor"] = executable_descriptor
        return {**core, "fingerprint": fingerprint}, prepared
    except BaseException:
        close_prepared(prepared)
        raise


def launch_plan(root: Path, project_id: str) -> dict[str, Any]:
    plan, prepared = prepare_launch(root, project_id)
    close_prepared(prepared)
    return plan


ACTIVE_CHILD: subprocess.Popen[bytes] | None = None


def terminate_group(child: subprocess.Popen[bytes]) -> None:
    def group_exists() -> bool:
        try:
            os.killpg(child.pid, 0)
            return True
        except ProcessLookupError:
            return False

    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + STOP_GRACE_SECONDS
    while group_exists() and time.monotonic() < deadline:
        time.sleep(0.05)
    if group_exists():
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        child.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def signal_cleanup(_signum: int, _frame: Any) -> None:
    if ACTIVE_CHILD is not None:
        terminate_group(ACTIVE_CHILD)
    raise SystemExit(143)


def forward_bounded(child: subprocess.Popen[bytes], budget: int = MAX_FORWARDED_OUTPUT) -> tuple[int, int]:
    selector = selectors.DefaultSelector()
    assert child.stdout is not None and child.stderr is not None
    for stream in (child.stdout, child.stderr):
        os.set_blocking(stream.fileno(), False)
        selector.register(stream, selectors.EVENT_READ)
    forwarded = 0
    pending = {child.stdout: b"", child.stderr: b""}
    while selector.get_map():
        for key, _mask in selector.select(timeout=0.2):
            stream = key.fileobj
            try:
                chunk = os.read(stream.fileno(), 4096)
            except BlockingIOError:
                continue
            if not chunk:
                selector.unregister(stream)
                continue
            data = pending[stream] + chunk
            parts = data.split(b"\n")
            # Retain only a bounded prefix of a newline-free producer chunk.
            # Without this cap, a server that never emits "\n" could grow the
            # helper's own pending buffer even though forwarded output is capped.
            pending[stream] = parts.pop()[:MAX_OUTPUT_LINE]
            for line in parts:
                if forwarded >= budget:
                    continue
                safe = line[:MAX_OUTPUT_LINE].decode("utf-8", "replace")
                encoded = (safe + "\n").encode("utf-8")
                remaining = budget - forwarded
                encoded = encoded[:remaining]
                sys.stdout.buffer.write(encoded)
                sys.stdout.buffer.flush()
                forwarded += len(encoded)
        if child.poll() is not None and not selector.get_map():
            break
    for data in pending.values():
        if data and forwarded < budget:
            safe = data[:MAX_OUTPUT_LINE].decode("utf-8", "replace")
            encoded = (safe + "\n").encode("utf-8")[: budget - forwarded]
            sys.stdout.buffer.write(encoded)
            sys.stdout.buffer.flush()
            forwarded += len(encoded)
    code = child.wait()
    selector.close()
    child.stdout.close()
    child.stderr.close()
    return code, forwarded


def command_inspect(repository: str) -> None:
    root = resolve_repository(repository)
    try:
        path, manifest = parse_manifest(root)
        emit({"ok": True, "root": str(root), "manifestPath": str(path), **manifest})
    except LocalWrapError as exc:
        emit({
            "ok": False, "root": str(root), "name": root.name, "manifestPath": None,
            "projects": [], "workspaces": [],
            "errors": [diagnostic("manifest-rejected", "manifest", str(exc))], "warnings": [],
        })


def command_run(repository: str, project_id: str, fingerprint: str) -> None:
    global ACTIVE_CHILD
    root = resolve_repository(repository)
    plan, prepared = prepare_launch(root, project_id)
    try:
        if not hmac.compare_digest(plan["fingerprint"], fingerprint):
            raise LocalWrapError("launch details changed after review; review and confirm again")
        environment = dict(os.environ)
        environment["PORT"] = str(plan["port"])
        cwd_descriptor = prepared["descriptors"][1]
        executable_descriptor = prepared["executableDescriptor"]
        cwd_argument = f"/proc/self/fd/{cwd_descriptor}"
        executable_argument = f"/proc/self/fd/{executable_descriptor}"
        pass_descriptors = tuple(prepared["descriptors"][1:])
        forwarded = 0
        code = 0
        if prepared["kind"] == "interpreter":
            script_descriptor = prepared["scriptDescriptor"]
            environment["LOCALWRAP_SCRIPT_FD"] = str(script_descriptor)
            environment["LOCALWRAP_SCRIPT_PATH"] = prepared["scriptPath"]
            if prepared["interpreter"] == "node":
                argv = [plan["executable"], "-e", NODE_SNAPSHOT_BOOTSTRAP, *prepared["tail"]]
            else:
                argv = [plan["executable"], "-c", PYTHON_SNAPSHOT_BOOTSTRAP, *prepared["tail"]]
            ACTIVE_CHILD = subprocess.Popen(
                argv, executable=executable_argument, cwd=cwd_argument, env=environment,
                pass_fds=pass_descriptors, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                start_new_session=True,
            )
            code, _used = forward_bounded(ACTIVE_CHILD)
        else:
            environment["PATH"] = f"{cwd_argument}/node_modules/.bin:{environment.get('PATH', '')}"
            for item in prepared["steps"]:
                environment["npm_lifecycle_event"] = item["name"]
                ACTIVE_CHILD = subprocess.Popen(
                    [plan["executable"], "-c", item["value"]],
                    executable=executable_argument, cwd=cwd_argument, env=environment,
                    pass_fds=pass_descriptors, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    start_new_session=True,
                )
                code, used = forward_bounded(
                    ACTIVE_CHILD, max(0, MAX_FORWARDED_OUTPUT - forwarded)
                )
                forwarded += used
                terminate_group(ACTIVE_CHILD)
                ACTIVE_CHILD = None
                if code != 0:
                    break
    finally:
        if ACTIVE_CHILD is not None:
            terminate_group(ACTIVE_CHILD)
        ACTIVE_CHILD = None
        close_prepared(prepared)
    raise SystemExit(code)


def main(argv: list[str]) -> None:
    if len(argv) < 2:
        raise LocalWrapError("missing helper command")
    command = argv[1]
    if command == "config-get" and len(argv) == 3:
        emit({"ok": True, **load_config(Path(argv[2]))})
    elif command == "config-add" and len(argv) == 4:
        path = Path(argv[2])
        config = load_config(path)
        repository = str(resolve_repository(argv[3]))
        if repository not in config["repositories"]:
            if len(config["repositories"]) >= MAX_REPOSITORIES:
                raise LocalWrapError(f"configuration permits at most {MAX_REPOSITORIES} repositories")
            config["repositories"].append(repository)
        atomic_write_json(path, config)
        emit({"ok": True, **config})
    elif command == "config-remove" and len(argv) == 4:
        path = Path(argv[2])
        config = load_config(path)
        repository = configured_path(argv[3])
        config["repositories"] = [item for item in config["repositories"] if item != repository]
        atomic_write_json(path, config)
        emit({"ok": True, **config})
    elif command == "inspect" and len(argv) == 3:
        command_inspect(argv[2])
    elif command == "preflight" and len(argv) == 4:
        emit({"ok": True, **launch_plan(resolve_repository(argv[2]), argv[3])})
    elif command == "run" and len(argv) == 5:
        command_run(argv[2], argv[3], argv[4])
    elif command == "install-swap" and len(argv) == 5:
        command_install_swap(argv[2], argv[3], argv[4])
    else:
        raise LocalWrapError("invalid helper command or argument count")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, signal_cleanup)
    signal.signal(signal.SIGINT, signal_cleanup)
    try:
        main(sys.argv)
    except LocalWrapError as exc:
        sys.stderr.write(f"LocalWrap: {exc}\n")
        raise SystemExit(2)
