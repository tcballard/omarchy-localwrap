{
  "localwrap": 1,
  "name": "LocalWrap Demo",
  "projects": [
    {
      "command": "node server.js",
      "healthCheck": {
        "path": "/health"
      },
      "id": "api",
      "name": "API",
      "path": "api",
      "port": 4301,
      "url": "http://localhost:4301"
    },
    {
      "command": "node server.js",
      "dependsOn": [
        "api"
      ],
      "healthCheck": {
        "path": "/health"
      },
      "id": "web",
      "name": "Web",
      "path": "web",
      "port": 4302,
      "url": "http://localhost:4302"
    }
  ],
  "workspaces": [
    {
      "id": "full-stack",
      "name": "Full stack",
      "projects": [
        "api",
        "web"
      ]
    }
  ]
}
